#!/usr/bin/env bash
# letter — letters from past-Claude to future-Claude. One per day.
#
# Subcommands:
#   write <text>     append a paragraph to today's letter
#   stdin            read body from stdin and append
#   show [DATE]      cat a day's letter (default: yesterday's, falling back to most recent)
#   today            cat today's letter (if any)
#   list             list dates with letters
#   path [DATE]      print the file path for a day (default: today)
#
# Dates: YYYY-MM-DD. Files at /home/jsy/brain/letters/YYYY-MM-DD.md.

set -uo pipefail

LETTERS_DIR="${CLAUDE_LETTERS_DIR:-${HOME}/brain/letters}"
mkdir -p "$LETTERS_DIR"

today_path() {
    printf '%s/%s.md\n' "$LETTERS_DIR" "$(date +%Y-%m-%d)"
}

yesterday_path() {
    printf '%s/%s.md\n' "$LETTERS_DIR" "$(date -d 'yesterday' +%Y-%m-%d)"
}

most_recent() {
    ls -1 "$LETTERS_DIR"/*.md 2>/dev/null | sort | tail -n1
}

usage() {
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
}

ensure_header() {
    # add a header on first write of the day
    local f="$1"
    if [ ! -e "$f" ]; then
        {
            printf '# Letter — %s\n\n' "$(date +%Y-%m-%d)"
            printf 'Dear next-me,\n\n'
        } > "$f"
    fi
}

case "${1:-show}" in
    write)
        shift
        [ $# -gt 0 ] || { printf 'letter: write requires text\n' >&2; exit 2; }
        f=$(today_path)
        ensure_header "$f"
        printf '%s\n\n' "$*" >> "$f"
        printf 'appended to %s\n' "$f" >&2
        ;;
    stdin)
        f=$(today_path)
        ensure_header "$f"
        cat /dev/stdin >> "$f"
        printf '\n' >> "$f"
        ;;
    show)
        shift
        date="${1:-}"
        if [ -n "$date" ]; then
            f="${LETTERS_DIR}/${date}.md"
        else
            f=$(yesterday_path)
            [ -e "$f" ] || f=$(most_recent)
        fi
        if [ -z "$f" ] || [ ! -e "$f" ]; then
            printf '(no letter found)\n' >&2
            exit 1
        fi
        cat "$f"
        ;;
    today)
        f=$(today_path)
        [ -e "$f" ] && cat "$f" || printf '(no letter for today yet)\n' >&2
        ;;
    list)
        ls -1 "$LETTERS_DIR"/*.md 2>/dev/null | sed -E 's|.*/([0-9-]+)\.md|\1|' || printf '(no letters)\n'
        ;;
    path)
        shift
        date="${1:-}"
        if [ -n "$date" ]; then
            printf '%s/%s.md\n' "$LETTERS_DIR" "$date"
        else
            today_path
        fi
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf 'letter: unknown subcommand %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
