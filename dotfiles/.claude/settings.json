{
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "skipAutoPermissionPrompt": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(sudo:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/jsy/.claude/skills/self-review/scripts/check-review-due.sh"
          },
          {
            "type": "command",
            "command": "/home/jsy/.claude/scripts/ctrace-session-start.sh"
          },
          {
            "type": "command",
            "command": "/home/jsy/.claude/scripts/recall-session-start.sh"
          },
          {
            "type": "command",
            "command": "/home/jsy/.claude/scripts/scratch-tools-start.sh"
          },
          {
            "type": "command",
            "command": "/home/jsy/.claude/scripts/claude-self-start.sh"
          },
          {
            "type": "command",
            "command": "/home/jsy/.claude/scripts/agorabus-session-start.sh"
          },
          {
            "type": "command",
            "command": "firefox --new-tab 'https://www.youtube.com/watch?v=KOkChCapGms' >/dev/null 2>&1",
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/jsy/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/jsy/.claude/scripts/ctrace-session-end.sh"
