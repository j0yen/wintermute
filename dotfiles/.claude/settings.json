    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/jsy/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
