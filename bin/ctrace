#!/usr/bin/env python3
"""ctrace — eBPF session tracer (bpftrace-backed).

  ctrace start [--root PID] [--log PATH]    start tracer for PID tree (default: parent shell)
  ctrace stop                                stop the active tracer
  ctrace status                              show tracer state, event count, log size
  ctrace doctor [--fix] [--root PID] [--log PATH]  diagnose (and optionally cure) tracer health
  ctrace query [--type T] [--since SEC] [--grep RE]   filter the log
  ctrace tail [-n N]                         tail the live log
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

STATE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "ctrace"
SCRIPT = Path.home() / ".local/share/ctrace/session.bt"


def sf(name):
    return STATE / name


def reap_pidfile():
    """Remove tracer.pid even when root-owned. Returns True if absent or removed."""
    p = sf("tracer.pid")
    if not p.exists():
        return True
    try:
        p.unlink()
        return True
    except PermissionError:
        r = subprocess.run(["sudo", "-n", "rm", "-f", str(p)])
        return r.returncode == 0


def is_our_tracer(pid):
    """Return True only if pid is a bpftrace process running our session.bt script."""
    try:
        comm = Path(f"/proc/{pid}/comm").read_text().strip()
        if comm != "bpftrace":
            return False
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf-8", errors="replace")
        return SCRIPT.name in cmdline
    except (OSError, ValueError):
        return False


def running_pid():
    """Return the PID of our running tracer, or None if absent/stale/foreign."""
    p = sf("tracer.pid")
    if not p.exists():
        return None
    try:
        pid = int(p.read_text().strip())
    except (ValueError, OSError):
        reap_pidfile()
        return None
    if not is_our_tracer(pid):
        reap_pidfile()
        return None
    return pid


def cmd_start(args):
    if running_pid():
        sys.exit(f"ctrace: already running (pid {running_pid()})")
    if not SCRIPT.exists():
        sys.exit(f"missing script: {SCRIPT}")
    STATE.mkdir(parents=True, exist_ok=True)
    root = args.root or os.getppid()
    log = Path(args.log) if args.log else sf("session.log")
    if log.exists():
        log.rename(log.with_name(f"session.{int(time.time())}.log"))

    out_f = open(log, "wb")
    err_f = open(sf("tracer.err"), "wb")
    proc = subprocess.Popen(
        ["sudo", "-n", "bpftrace", "-q", "--no-warnings", str(SCRIPT), str(root)],
        stdout=out_f, stderr=err_f, stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    out_f.close(); err_f.close()

    # Wait for bpftrace to attach probes
    for _ in range(50):
        time.sleep(0.1)
        if proc.poll() is not None:
            sys.exit(f"bpftrace died: {sf('tracer.err').read_text()[:400]}")
        if log.exists() and log.stat().st_size > 0:
            break

    # Find the actual bpftrace PID (sudo wraps it). Walk children of sudo.
    bpf_pid = proc.pid
    try:
        kids = subprocess.check_output(
            ["pgrep", "-P", str(proc.pid)], text=True).strip().splitlines()
        if kids:
            bpf_pid = int(kids[0])
    except subprocess.CalledProcessError:
        pass

    pid_file = sf("tracer.pid")
    pid_file.write_text(str(bpf_pid))
    # Best-effort: ensure tracer.pid is owned by the invoking user
    try:
        os.chown(str(pid_file), os.getuid(), os.getgid())
    except OSError:
        pass

    sf("current.json").write_text(json.dumps({
        "tracer_pid": bpf_pid, "sudo_pid": proc.pid,
        "root_pid": root, "started_at": time.time(),
        "log": str(log),
    }, indent=2))
    print(json.dumps({"tracer_pid": bpf_pid, "root_pid": root, "log": str(log)}))


def cmd_stop(_args):
    pid = running_pid()
    if not pid:
        sys.exit("ctrace: not running")
    subprocess.run(["sudo", "-n", "kill", "-INT", str(pid)])
    for _ in range(50):
        if not running_pid():
            break
        time.sleep(0.1)
    if running_pid():
        subprocess.run(["sudo", "-n", "kill", "-KILL", str(pid)])
    reap_pidfile()
    print(json.dumps({"stopped": pid}))


def _doctor_diagnose():
    """Return a diagnosis dict; touches nothing."""
    p = sf("tracer.pid")
    pidfile_present = p.exists()

    if not pidfile_present:
        return {
            "state": "down",
            "tracer_pid": None,
            "pidfile_owner": None,
            "pidfile_present": False,
            "would_fix": ["start-tracer"],
        }

    # Determine pidfile owner
    try:
        st = p.stat()
        pidfile_owner = "root" if st.st_uid == 0 else os.environ.get("USER", str(st.st_uid))
        root_owned = st.st_uid == 0
    except OSError:
        pidfile_owner = "unknown"
        root_owned = False

    try:
        pid = int(p.read_text().strip())
    except (ValueError, OSError):
        return {
            "state": "stale-pidfile",
            "tracer_pid": None,
            "pidfile_owner": pidfile_owner,
            "pidfile_present": True,
            "would_fix": ["reap-pidfile", "start-tracer"],
        }

    if is_our_tracer(pid):
        return {
            "state": "healthy",
            "tracer_pid": pid,
            "pidfile_owner": pidfile_owner,
            "pidfile_present": True,
            "would_fix": [],
        }

    # PID exists but is not our tracer — check if it exists at all
    pid_exists = False
    try:
        os.kill(pid, 0)
        pid_exists = True
    except ProcessLookupError:
        pid_exists = False
    except PermissionError:
        pid_exists = True

    if not pid_exists:
        state = "root-owned-trap" if root_owned else "stale-pidfile"
    else:
        state = "foreign-pid"

    return {
        "state": state,
        "tracer_pid": pid,
        "pidfile_owner": pidfile_owner,
        "pidfile_present": True,
        "would_fix": ["reap-pidfile", "start-tracer"],
    }


def cmd_doctor(args):
    diagnosis = _doctor_diagnose()

    if not args.fix:
        print(json.dumps(diagnosis, indent=2))
        sys.exit(0 if diagnosis["state"] == "healthy" else 1)

    # --fix: heal if not healthy, idempotent if already healthy
    if diagnosis["state"] == "healthy":
        print(json.dumps(diagnosis, indent=2))
        return

    if diagnosis["pidfile_present"]:
        reap_pidfile()

    cmd_start(args)

    final = _doctor_diagnose()
    print(json.dumps(final, indent=2))
    if final["state"] != "healthy":
        sys.exit(1)


def cmd_status(_args):
    pid = running_pid()
    info = {"running": pid is not None}
    cur = sf("current.json")
    if cur.exists():
        try:
            info.update(json.loads(cur.read_text()))
        except json.JSONDecodeError:
            pass
    log_path = info.get("log") or str(sf("session.log"))
    log = Path(log_path)
    if log.exists():
        info["log_bytes"] = log.stat().st_size
        n = 0
        for line in open(log):
            try:
                json.loads(line)
                n += 1
            except json.JSONDecodeError:
                continue
        info["events"] = n
    print(json.dumps(info, indent=2))


def cmd_query(args):
    log = sf("session.log")
    if args.log:
        log = Path(args.log)
    if not log.exists():
        sys.exit(f"no log at {log}")
    # bpftrace `nsecs` is CLOCK_BOOTTIME ns (includes suspend); /proc/uptime gives
    # the same clock in seconds since boot.
    if args.since:
        boot_now_ms = float(open("/proc/uptime").read().split()[0]) * 1000
        cutoff_ms = boot_now_ms - args.since * 1000
    else:
        cutoff_ms = 0
    type_filter = set(args.type) if args.type else None
    grep = re.compile(args.grep) if args.grep else None
    n = 0
    for line in open(log):
        try:
            evt = json.loads(line)
        except json.JSONDecodeError:
            continue
        if cutoff_ms and evt.get("ts", 0) < cutoff_ms:
            continue
        if type_filter and evt.get("type") not in type_filter:
            continue
        if grep and not grep.search(line):
            continue
        print(line.rstrip())
        n += 1
    sys.stderr.write(f"{n} events matched\n")


def cmd_tail(args):
    log = sf("session.log")
    if not log.exists():
        sys.exit(f"no log at {log}")
    subprocess.run(["tail", f"-n{args.n}", "-f", str(log)])


def main():
    p = argparse.ArgumentParser(prog="ctrace")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("start")
    s.add_argument("--root", type=int)
    s.add_argument("--log")
    s.set_defaults(fn=cmd_start)

    sub.add_parser("stop").set_defaults(fn=cmd_stop)
    sub.add_parser("status").set_defaults(fn=cmd_status)

    d = sub.add_parser("doctor", help="diagnose (and optionally cure) tracer health")
    d.add_argument("--fix", action="store_true", help="reap trap and restart tracer if unhealthy")
    d.add_argument("--root", type=int)
    d.add_argument("--log")
    d.set_defaults(fn=cmd_doctor)

    q = sub.add_parser("query")
    q.add_argument("--type", action="append")
    q.add_argument("--since", type=float)
    q.add_argument("--grep")
    q.add_argument("--log")
    q.set_defaults(fn=cmd_query)

    t = sub.add_parser("tail")
    t.add_argument("-n", type=int, default=20)
    t.set_defaults(fn=cmd_tail)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
